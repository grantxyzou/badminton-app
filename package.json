{
  "name": "badminton-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "node scripts/extract-unreleased.mjs && next dev",
    "dev:next": "NEXT_PUBLIC_BASE_PATH=/bpm NEXT_PUBLIC_ENV=next NEXT_PUBLIC_FLAG_DESIGN_PREVIEW=true NEXT_PUBLIC_FLAG_VALUE_HUB_SLICE=true NEXT_PUBLIC_FLAG_KUDOS=true NEXT_PUBLIC_FLAG_GEAR_RECOMMENDER=true NEXT_PUBLIC_FLAG_VISUAL_FIELDS=true NEXT_PUBLIC_FLAG_AUTH_PROVIDERS=true NEXT_PUBLIC_FLAG_STRINGING=true NEXT_PUBLIC_FLAG_PUSH_NOTIFY=true npm run dev",
    "dev:next:mock": "COSMOS_CONNECTION_STRING= SEED_DEV_SCENARIO=fresh-thursday SEED_DEV_ADMIN=Grant:1130 npm run dev:next",
    "prebuild": "node scripts/extract-unreleased.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@azure/cosmos": "^4.10.0",
    "@capacitor-firebase/messaging": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@formatjs/intl-localematcher": "^0.8.13",
    "arctic": "^3.7.0",
    "next": "^16.3.3",
    "next-intl": "^4.14.0",
    "nodemailer": "^9.0.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.3.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "^8.5.26"
  }
}
