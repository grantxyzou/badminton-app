ANTHROPIC_API_KEY=
COSMOS_CONNECTION_STRING=
COSMOS_DB_NAME=
ADMIN_PIN=
NEXT_PUBLIC_MAX_PLAYERS=

# Required in production (NODE_ENV=production): the HMAC key for admin/member
# session cookies. Missing/short -> the app refuses to sign sessions (fail-closed,
# #142). Generate with: openssl rand -hex 32. Local dev/test fall back to a
# sentinel if unset.
SESSION_SECRET=

# Optional. Pin a single trusted client-IP header (e.g. cf-connecting-ip behind
# Cloudflare) for rate limiting on a non-Azure host; skips the spoofable
# X-Forwarded-For fallback. Leave unset on Azure App Service (default behaviour).
TRUSTED_IP_HEADER=

# Required: must match next.config.js basePath. Without it the client fetches
# /api/* unprefixed -> 404 -> a false app-wide "You're offline" state.
NEXT_PUBLIC_BASE_PATH=/bpm

# Stats v2 is the only Stats path as of Stage 8 (2026-08-20) — the v1 fallback
# was deleted. This flag no longer picks a layout; it only guards the three
# v2-only API routes (/api/stats/club/bands, /api/stats/club/gear,
# /api/stats/drills/done). Leave it unset locally and those routes 404 while the
# tab still renders v2, so "Where you sit" and Learn show load errors on a
# perfectly healthy server. Set it. (It is 'true' in all three CI/deploy configs.)

# Multi-provider auth (email+password, Google, Apple). Tracked but OFF by
# default: NEXT_PUBLIC_* is baked at build time, so this cannot be flipped from
# Azure App Settings -- it lives in .github/workflows/deploy-next.yml for prod.
# The name+PIN path is unaffected either way and is NOT being retired.
NEXT_PUBLIC_FLAG_AUTH_PROVIDERS=false

# Absolute origin used to build links that leave the app: the email
# verification and password reset links, and the OAuth redirect URIs. Server
# only (deliberately NOT NEXT_PUBLIC_) so it can be changed in Azure App
# Settings without a rebuild.
#
# The fallback is the request's own origin, which behind the Azure App Service
# proxy can resolve to an INTERNAL hostname -- producing verification emails
# whose links point somewhere the recipient cannot reach. Same class of failure
# as an unset NEXT_PUBLIC_BASE_PATH. Set it in production.
# Production: https://bpm.grantzou.com
APP_ORIGIN=http://localhost:3000
