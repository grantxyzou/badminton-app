# dependencies
node_modules/

# superpowers brainstorm artifacts
.superpowers/

# next.js
.next/
out/

# environment variables (keep secrets out of git)
.env.local
.env*.local
.env.local.bak
# the .env*.local glob above is anchored to a .local suffix, so it does NOT
# match a .bak sibling (e.g. a `sed -i.bak` backup). Catch the whole class:
*.bak

# Local-only real attendance data (never tracked). The backfill script reads
# this path by default; keep real member names + dates out of the public repo.
# See scripts/data/attendance.example.csv for the format.
scripts/data/attendance.csv

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# typescript
tsconfig.tsbuildinfo

# misc
.DS_Store
*.pem

# deployment artifacts
*.zip
.azure/

# Worktrees
.worktrees/

# Session-generated review/screenshot artifacts
c1-review-*.png
c1-polish-*.png
review-mobile-*.png
branch-admin.png
branch-non-admin.png
live-admin.png
live-non-admin.png
favicon.png
# Root-anchored so it can never swallow a real asset under public/ or app/.
# This block grows one filename at a time; prefer a `/prefix-*.png` pattern
# over another literal name when the next batch appears.
/gear-*.png

# Design playgrounds (one-off explorations, not shipped)
*-playground.html

# Playwright MCP screenshot cache
.playwright-mcp/

# Editor preferences (per-machine, not a project requirement)
.vscode/

# Agent memory (per-machine scratch — agents regenerate on next run)
.claude/agent-memory/

# Claude Code runtime lock files
.claude/scheduled_tasks.lock
.claude/*.lock

# Claude Code git worktrees (a full second checkout of this repo lives here —
# `.worktrees/` above covers the old location, this covers the current one)
.claude/worktrees/

# Plugin-settings pattern: per-project state files (user-managed, not shared)
# Each .claude/<name>.local.md stores YAML frontmatter config for a hook or
# plugin. Templates live in docs/automation/ — copy and customize per machine.
.claude/*.local.md
.claude/*.local.json

# Auto-generated by scripts/extract-unreleased.mjs (regenerates on every build/dev)
public/changelog-unreleased.json

# Screenshot/debugging artifacts (numbered prefix or dated)
/[0-9][0-9]-*.png
/[0-9][0-9][a-z]-*.png

# Native shell (Capacitor). The projects are committed; their build output,
# dependency caches and signing material are not.
ios/App/build/
ios/App/Pods/
ios/App/App.xcworkspace/xcuserdata/
ios/App/App.xcodeproj/xcuserdata/
ios/App/App.xcodeproj/project.xcworkspace/xcuserdata/
ios/DerivedData/
android/.gradle/
android/.idea/
android/build/
android/app/build/
android/app/release/
android/local.properties
android/capacitor-cordova-android-plugins/
*.keystore
*.jks
*.p8
*.p12
*.mobileprovision
