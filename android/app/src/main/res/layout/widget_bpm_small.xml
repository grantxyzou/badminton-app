<?xml version="1.0" encoding="utf-8"?>
<!-- 2 × 2: the week alone, one tap target (docs/plans/native-widgets.md). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bpm_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bpm_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BPM"
        android:textColor="@color/bpm_widget_secondary"
        android:textSize="11sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/bpm_small_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.08"
        android:text="YOU'RE IN"
        android:textColor="@color/bpm_widget_green"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/bpm_small_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:text="Thu, Oct 23"
        android:textColor="@color/bpm_widget_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/bpm_small_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:text="7 PM · 9 of 12 in"
        android:textColor="@color/bpm_widget_secondary"
        android:textSize="12sp" />

    <ProgressBar
        android:id="@+id/bpm_fill"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="8dp"
        android:max="12"
        android:progress="9"
        android:progressBackgroundTint="@color/bpm_widget_track"
        android:progressTint="@color/bpm_widget_green" />
</LinearLayout>
