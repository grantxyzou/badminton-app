<?xml version="1.0" encoding="utf-8"?>
<!-- Game point on the score widget: the card's ground with an amber wash —
     no rim, the widget draws no strokes — the one moment worth seeing from
     across the court. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bpm_widget_bg" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bpm_widget_amber_soft" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
