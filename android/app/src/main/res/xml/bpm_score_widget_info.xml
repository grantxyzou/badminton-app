<?xml version="1.0" encoding="utf-8"?>
<!-- Keep score: 4 × 2, one size. Nothing to refresh on a timer — every tap
     redraws it (BpmScoreWidgetProvider). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:resizeMode="none"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_bpm_score"
    android:previewLayout="@layout/widget_bpm_score"
    android:description="@string/score_widget_description"
    android:widgetCategory="home_screen" />
