<?xml version="1.0" encoding="utf-8"?>
<!-- Keep score: 4 × 2 by default, resizable down the screen — at 4 × 3 and
     4 × 4 it becomes the court-side scoreboard with tonight's games
     (widget_bpm_score_large, chosen by height in BpmScoreWidgetProvider).
     Nothing to refresh on a timer: every tap redraws it. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:minResizeWidth="250dp"
    android:minResizeHeight="110dp"
    android:maxResizeWidth="420dp"
    android:maxResizeHeight="360dp"
    android:resizeMode="vertical"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_bpm_score"
    android:previewLayout="@layout/widget_bpm_score"
    android:description="@string/score_widget_description"
    android:widgetCategory="home_screen" />
