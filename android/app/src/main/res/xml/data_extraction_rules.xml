<?xml version="1.0" encoding="utf-8"?>
<!--
  What Android's backup and device-to-device transfer may take, Android 12 and up
  (android:dataExtractionRules). The widget's pass stays on the phone it was made
  on; see backup_rules.xml for why.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="bpm_widget.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="bpm_widget.xml" />
    </device-transfer>
</data-extraction-rules>
