{
  "enabledPlugins": {
    "plugin-dev@claude-plugins-official": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/check-flag-sync.mjs"
          },
          {
            "type": "command",
            "command": "node scripts/check-i18n-keys.mjs"
          },
          {
            "type": "command",
            "command": "node scripts/check-lint-errors.mjs"
          },
          {
            "type": "command",
            "command": "node scripts/check-schema-additive.mjs"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/block-tab-screenshot.mjs"
          }
        ]
      }
    ]
  }
}
