# Refuse to install anything that declares it doesn't support this Node.
#
# npm treats `engines` as advice by default: it prints `npm warn EBADENGINE`
# and installs anyway. That default cost us a real incident. jsdom 30 declares
# `node: ^22.22.2 || ...` and was installed on Node 20 regardless, where its
# undici 8 dependency threw at module load — so 67 test files contributed ZERO
# tests instead of failing ones, and `npm test` reported "113 passed" while 498
# tests silently did not exist.
#
# A refused install is a legible failure. A green run missing a third of its
# tests is not. This is the same principle as the app's own "lying empty state
# is forbidden" rule, applied to the toolchain.
#
# The floor lives in package.json `engines.node` and is set to the strictest
# requirement actually present in the tree (jsdom's ^22.22.2), not a round
# number — so a Node that satisfies this project also satisfies its
# dependencies, and the error names us rather than a transitive package.
engine-strict=true
